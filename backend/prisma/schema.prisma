generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Olympiad {
  id           String           @id @default(uuid())
  name         String
  timezone     String
  description  String?
  grades       String?
  startDate    DateTime?
  endDate      DateTime?
  organiserId  String?
  organiser    User?            @relation(fields: [organiserId], references: [id])
  rounds       Round[]
  schoolAccess SchoolOlympiad[]
}

model Round {
  id                     String             @id @default(uuid())
  olympiadId             String
  name                   String
  openTime               DateTime
  closeTime              DateTime
  state                  String             @default("scheduled")
  qualifyingThreshold    Float?
  autoAdvanceProcessedAt DateTime?
  prerequisiteRoundId    String?
  AuditLog               AuditLog[]
  notificationLogs       NotificationLog[]
  notificationRules      NotificationRule[]
  paper                  Paper?
  olympiad               Olympiad           @relation(fields: [olympiadId], references: [id])
  prerequisiteRound      Round?             @relation("RoundPrerequisites", fields: [prerequisiteRoundId], references: [id])
  dependentRounds        Round[]            @relation("RoundPrerequisites")
  roundEntrants          RoundEntrant[]
  sittings               Sitting[]
  submissions            Submission[]
}

model User {
  id                                             String          @id @default(uuid())
  email                                          String          @unique
  role                                           String
  createdAt                                      DateTime        @default(now())
  name                                           String
  clerkUserId                                    String?         @unique
  invitationExpiresAt                            DateTime?
  invitationToken                                String?         @unique
  passwordHash                                   String?
  educator                                       Educator?
  entrant                                        Entrant?
  assignedMarkingTasks                           MarkingTask[]   @relation("AssignedMarkingTasks")
  moderatedMarkingTasks                          MarkingTask[]   @relation("ModeratedMarkingTasks")
  olympiads                                      Olympiad[]
  RemarkRequest_RemarkRequest_assignedToIdToUser RemarkRequest[] @relation("RemarkRequest_assignedToIdToUser")
  requestedRemarks                               RemarkRequest[] @relation("RequestedRemarks")
  reviewedRemarks                                RemarkRequest[] @relation("ReviewedRemarks")
}

model School {
  id              String           @id @default(uuid())
  name            String
  timezone        String
  createdAt       DateTime         @default(now())
  educators       Educator[]
  entrants        Entrant[]
  schoolOlympiads SchoolOlympiad[]
}

model SchoolOlympiad {
  id            String    @id @default(uuid())
  schoolId      String
  olympiadId    String
  status        String    @default("pending")
  requestedById String?
  requestedAt   DateTime  @default(now())
  decidedAt     DateTime?
  olympiad      Olympiad  @relation(fields: [olympiadId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, olympiadId])
}

model Educator {
  id       String @id @default(uuid())
  userId   String @unique
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model Entrant {
  id               String            @id @default(uuid())
  schoolId         String
  name             String
  grade            String
  userId           String?           @unique
  school           School            @relation(fields: [schoolId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  notificationLogs NotificationLog[]
  roundEntrants    RoundEntrant[]
  sittings         Sitting[]
  submissions      Submission[]
}

model Paper {
  id          String   @id @default(uuid())
  roundId     String   @unique
  fileUrl     String
  memoUrl     String
  uploadedAt  DateTime @default(now())
  memoAnswers Json?
  round       Round    @relation(fields: [roundId], references: [id])
}

model Submission {
  id             String          @id @default(uuid())
  roundId        String
  entrantId      String
  answers        Json
  idempotencyKey String          @unique
  submittedAt    DateTime        @default(now())
  markingTask    MarkingTask?
  remarkRequests RemarkRequest[]
  result         Result?
  entrant        Entrant         @relation(fields: [entrantId], references: [id])
  round          Round           @relation(fields: [roundId], references: [id])
}

model MarkingTask {
  id             String     @id @default(uuid())
  submissionId   String     @unique
  status         String     @default("unassigned")
  assignedToId   String?
  score          Float?
  breakdown      Json?
  markedAt       DateTime?
  moderatedById  String?
  moderatedScore Float?
  moderatedAt    DateTime?
  createdAt      DateTime   @default(now())
  assignedTo     User?      @relation("AssignedMarkingTasks", fields: [assignedToId], references: [id])
  moderatedBy    User?      @relation("ModeratedMarkingTasks", fields: [moderatedById], references: [id])
  submission     Submission @relation(fields: [submissionId], references: [id])
}

model Result {
  id           String     @id @default(uuid())
  submissionId String     @unique
  score        Float
  releasedAt   DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RemarkRequest {
  id                                    String     @id @default(uuid())
  submissionId                          String
  requestedById                         String
  reason                                String
  status                                String     @default("pending")
  newScore                              Float?
  reviewedById                          String?
  reviewNotes                           String?
  createdAt                             DateTime   @default(now())
  reviewedAt                            DateTime?
  assignedToId                          String?
  User_RemarkRequest_assignedToIdToUser User?      @relation("RemarkRequest_assignedToIdToUser", fields: [assignedToId], references: [id])
  requestedBy                           User       @relation("RequestedRemarks", fields: [requestedById], references: [id])
  reviewedBy                            User?      @relation("ReviewedRemarks", fields: [reviewedById], references: [id])
  submission                            Submission @relation(fields: [submissionId], references: [id])

  @@index([assignedToId, status])
}

model RoundEntrant {
  id           String   @id @default(uuid())
  roundId      String
  entrantId    String
  registeredAt DateTime @default(now())
  entrant      Entrant  @relation(fields: [entrantId], references: [id])
  round        Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

model Sitting {
  id          String    @id @default(uuid())
  entrantId   String
  roundId     String
  answers     Json?
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  entrant     Entrant   @relation(fields: [entrantId], references: [id])
  round       Round     @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

model NotificationLog {
  id             String   @id @default(uuid())
  roundId        String
  entrantId      String?
  triggerType    String
  recipientEmail String
  status         String   @default("sent")
  error          String?
  sentAt         DateTime @default(now())
  entrant        Entrant? @relation(fields: [entrantId], references: [id])
  round          Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, triggerType, recipientEmail])
}

model NotificationRule {
  id            String   @id @default(uuid())
  roundId       String
  triggerType   String
  enabled       Boolean  @default(true)
  recipientRole String   @default("educator")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  round         Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, triggerType])
}

model AuditLog {
  id        String   @id
  action    String
  timestamp DateTime @default(now())
  roundId   String?
  payload   Json?
  Round     Round?   @relation(fields: [roundId], references: [id])
}
