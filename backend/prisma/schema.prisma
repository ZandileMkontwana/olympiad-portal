generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Olympiad {
  id       String  @id @default(uuid())
  name     String
  timezone String
  rounds   Round[]
}

model Round {
  id               String            @id @default(uuid())
  olympiadId       String
  name             String
  openTime         DateTime
  closeTime        DateTime
  state            String            @default("scheduled")
  paper            Paper?
  olympiad         Olympiad          @relation(fields: [olympiadId], references: [id])
  roundEntrants    RoundEntrant[]
  submissions      Submission[]
  sittings         Sitting[]
  notificationLogs NotificationLog[]
  notificationRules NotificationRule[]
}

model User {
  id          String    @id @default(uuid())
  clerkUserId String    @unique
  email       String    @unique
  role        String
  createdAt   DateTime  @default(now())
  name        String
  educator    Educator?
  entrant     Entrant?
}

model School {
  id        String     @id @default(uuid())
  name      String
  timezone  String
  createdAt DateTime   @default(now())
  educators Educator[]
  entrants  Entrant[]
}

model Educator {
  id       String @id @default(uuid())
  userId   String @unique
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model Entrant {
  id               String            @id @default(uuid())
  schoolId         String
  name             String
  grade            String
  userId           String?           @unique
  school           School            @relation(fields: [schoolId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  roundEntrants    RoundEntrant[]
  submissions      Submission[]
  sittings         Sitting[]
  notificationLogs NotificationLog[]
}

model Paper {
  id          String   @id @default(uuid())
  roundId     String   @unique
  fileUrl     String
  memoUrl     String
  uploadedAt  DateTime @default(now())
  memoAnswers Json?
  round       Round    @relation(fields: [roundId], references: [id])
}

model Submission {
  id             String   @id @default(uuid())
  roundId        String
  entrantId      String
  answers        Json
  idempotencyKey String   @unique
  submittedAt    DateTime @default(now())
  result         Result?
  entrant        Entrant  @relation(fields: [entrantId], references: [id])
  round          Round    @relation(fields: [roundId], references: [id])
}

model Result {
  id           String     @id @default(uuid())
  submissionId String     @unique
  score        Float
  releasedAt   DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RoundEntrant {
  id           String   @id @default(uuid())
  roundId      String
  entrantId    String
  registeredAt DateTime @default(now())
  entrant      Entrant  @relation(fields: [entrantId], references: [id])
  round        Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

// An online test-taking session for an entrant in a round.
// One sitting per entrant per round — an in-progress sitting can be
// resumed (A4) by POSTing to /rounds/:id/sittings again.
model Sitting {
  id          String    @id @default(uuid())
  entrantId   String
  roundId     String
  answers     Json?
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  entrant     Entrant   @relation(fields: [entrantId], references: [id])
  round       Round     @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

model NotificationLog {
  id             String   @id @default(uuid())
  roundId        String
  entrantId      String?
  triggerType    String // 'before_open' | 'before_close' | 'missing_submission' | 'results_released'
  recipientEmail String
  status         String   @default("sent") // 'sent' | 'failed'
  error          String?
  sentAt         DateTime @default(now())
  round          Round    @relation(fields: [roundId], references: [id])
  entrant        Entrant? @relation(fields: [entrantId], references: [id])

  @@unique([roundId, triggerType, recipientEmail])
}

model NotificationRule {
  id            String   @id @default(uuid())
  roundId       String
  triggerType   String // 'before_open' | 'before_close' | 'missing_submission' | 'results_released'
  enabled       Boolean  @default(true)
  recipientRole String   @default("educator") // 'educator' | 'organiser' | 'all'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  round         Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, triggerType])
}
