generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Olympiad {
  id           String              @id @default(uuid())
  name         String
  timezone     String              @default("UTC")
  description  String? // organiser-written blurb shown to educators requesting access
  grades       String? // target learner grades, e.g. "Grade 8-12"
  startDate    DateTime? // olympiad run dates, organiser-set
  endDate      DateTime?
  organiserId  String? // the organiser who created it; null = legacy/unowned
  rounds       Round[]
  schoolAccess SchoolOlympiad[]
  organiser    User?               @relation(fields: [organiserId], references: [id])
  organisers   OlympiadOrganiser[]
}

// A co-organiser's access to an olympiad. The creator (Olympiad.organiserId)
// is backfilled here so all access checks go through this single table.
// The creator is not removable — see removal rules in the routes.
model OlympiadOrganiser {
  id          String   @id @default(uuid())
  olympiadId  String
  organiserId String
  addedAt     DateTime @default(now())
  olympiad    Olympiad @relation(fields: [olympiadId], references: [id])
  organiser   User     @relation(fields: [organiserId], references: [id])

  @@unique([olympiadId, organiserId])
}

model Round {
  id                     String             @id @default(uuid())
  olympiadId             String
  name                   String
  openTime               DateTime
  closeTime              DateTime
  state                  String             @default("scheduled")
  qualifyingThreshold    Float?             // minimum score % (0-100) required to pass; null = no gate
  prerequisiteRoundId    String?            // the round that must be passed first; null = no prerequisite
  autoAdvanceProcessedAt DateTime?

  notificationLogs       NotificationLog[]
  notificationRules      NotificationRule[]
  auditLogs              AuditLog[]
  paper                  Paper?
  olympiad               Olympiad           @relation(fields: [olympiadId], references: [id])
  prerequisiteRound      Round?             @relation("RoundPrerequisites", fields: [prerequisiteRoundId], references: [id])
  dependentRounds        Round[]             @relation("RoundPrerequisites")
  roundEntrants          RoundEntrant[]
  sittings               Sitting[]
  submissions            Submission[]
}

model User {
  id                    String          @id @default(uuid())
  clerkUserId           String?         @unique
  email                 String          @unique
  role                  String
  createdAt             DateTime        @default(now())
  name                  String
  passwordHash          String?
  invitationToken       String?         @unique
  invitationExpiresAt   DateTime?
  educator              Educator?
  entrant               Entrant?
  olympiads             Olympiad[]
  organisedOlympiads    OlympiadOrganiser[]
  assignedMarkingTasks  MarkingTask[]   @relation("AssignedMarkingTasks")
  moderatedMarkingTasks MarkingTask[]   @relation("ModeratedMarkingTasks")
  requestedRemarks      RemarkRequest[] @relation("RequestedRemarks")
  assignedRemarks       RemarkRequest[] @relation("AssignedRemarkRequests")
  reviewedRemarks       RemarkRequest[] @relation("ReviewedRemarks")
}

model School {
  id              String           @id @default(uuid())
  name            String
  timezone        String
  createdAt       DateTime         @default(now())
  educators       Educator[]
  entrants        Entrant[]
  schoolOlympiads SchoolOlympiad[]
}

model SchoolOlympiad {
  id            String    @id @default(uuid())
  schoolId      String
  olympiadId    String
  status        String    @default("pending")
  requestedById String?
  requestedAt   DateTime  @default(now())
  decidedAt     DateTime?
  olympiad      Olympiad  @relation(fields: [olympiadId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, olympiadId])
}

model Educator {
  id       String @id @default(uuid())
  userId   String @unique
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model Entrant {
  id               String            @id @default(uuid())
  schoolId         String
  name             String
  grade            String
  userId           String?           @unique
  school           School            @relation(fields: [schoolId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  notificationLogs NotificationLog[]
  roundEntrants    RoundEntrant[]
  sittings         Sitting[]
  submissions      Submission[]
}

model Paper {
  id          String   @id @default(uuid())
  roundId     String   @unique
  fileUrl     String
  memoUrl     String
  uploadedAt  DateTime @default(now())
  memoAnswers Json?
  round       Round    @relation(fields: [roundId], references: [id])
}

model Submission {
  id             String          @id @default(uuid())
  roundId        String
  entrantId      String
  answers        Json
  idempotencyKey String          @unique
  submittedAt    DateTime        @default(now())
  markingTask    MarkingTask?
  remarkRequests RemarkRequest[]
  result         Result?
  entrant        Entrant         @relation(fields: [entrantId], references: [id])
  round          Round           @relation(fields: [roundId], references: [id])
}

model MarkingTask {
  id             String     @id @default(uuid())
  submissionId   String     @unique
  status         String     @default("unassigned")
  assignedToId   String?
  score          Float?
  breakdown      Json? // per-question partial credit, e.g. { "q1": 3, "q2": 5 }
  markedAt       DateTime?
  moderatedById  String?
  moderatedScore Float?
  moderatedAt    DateTime?
  createdAt      DateTime   @default(now())
  assignedTo     User?      @relation("AssignedMarkingTasks", fields: [assignedToId], references: [id])
  moderatedBy    User?      @relation("ModeratedMarkingTasks", fields: [moderatedById], references: [id])
  submission     Submission @relation(fields: [submissionId], references: [id])
}

model Result {
  id           String     @id @default(uuid())
  submissionId String     @unique
  score        Float
  releasedAt   DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RemarkRequest {
  id            String     @id @default(uuid())
  submissionId  String
  requestedById String
  reason        String
  status        String     @default("pending") // 'pending' | 'assigned' | 'approved' | 'rejected'
  assignedToId  String?
  newScore      Float? // updated score, set when approved
  reviewedById  String?
  reviewNotes   String?
  createdAt     DateTime   @default(now())
  reviewedAt    DateTime?
  submission    Submission @relation(fields: [submissionId], references: [id])
  requestedBy   User       @relation("RequestedRemarks", fields: [requestedById], references: [id])
  assignedTo    User?      @relation("AssignedRemarkRequests", fields: [assignedToId], references: [id])
  reviewedBy    User?      @relation("ReviewedRemarks", fields: [reviewedById], references: [id])

  @@index([assignedToId, status])
}

model RoundEntrant {
  id           String   @id @default(uuid())
  roundId      String
  entrantId    String
  registeredAt DateTime @default(now())
  entrant      Entrant  @relation(fields: [entrantId], references: [id])
  round        Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

model Sitting {
  id          String    @id @default(uuid())
  entrantId   String
  roundId     String
  answers     Json?
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  entrant     Entrant   @relation(fields: [entrantId], references: [id])
  round       Round     @relation(fields: [roundId], references: [id])

  @@unique([roundId, entrantId])
}

model NotificationLog {
  id             String   @id @default(uuid())
  roundId        String
  entrantId      String?
  triggerType    String
  recipientEmail String
  status         String   @default("sent")
  error          String?
  sentAt         DateTime @default(now())
  entrant        Entrant? @relation(fields: [entrantId], references: [id])
  round          Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, triggerType, recipientEmail])
}

model NotificationRule {
  id            String   @id @default(uuid())
  roundId       String
  triggerType   String
  enabled       Boolean  @default(true)
  recipientRole String   @default("educator")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  round         Round    @relation(fields: [roundId], references: [id])

  @@unique([roundId, triggerType])
}

// Records every automatic action the scheduler performs on a round
// (open, close, auto-advance, notification send) so organisers can
// audit what happened and when.
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // 'round_opened' | 'round_closed' | 'auto_advanced' | 'notification_sent' | 'entrants_registered'
  timestamp DateTime @default(now())
  roundId   String?
  payload   Json?    // detail data, e.g. { entrantId, nextRoundId } for auto-advance
  round     Round?   @relation(fields: [roundId], references: [id])
}

