generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Olympiad {
  id       String  @id @default(uuid())
  name     String
  timezone String
  rounds   Round[]
}

model Round {
  id            String         @id @default(uuid())
  olympiad      Olympiad       @relation(fields: [olympiadId], references: [id])
  olympiadId    String
  name          String
  openTime      DateTime
  closeTime     DateTime
  state         String         @default("scheduled")
  paper         Paper?
  submissions   Submission[]
  roundEntrants RoundEntrant[]
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String
  createdAt    DateTime  @default(now())
  educator     Educator?
}

model School {
  id        String     @id @default(uuid())
  name      String
  timezone  String
  createdAt DateTime   @default(now())
  educators Educator[]
  entrants  Entrant[]
}

model Educator {
  id       String @id @default(uuid())
  userId   String @unique
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model Entrant {
  id            String         @id @default(uuid())
  school        School         @relation(fields: [schoolId], references: [id])
  schoolId      String
  name          String
  grade         String
  submissions   Submission[]
  roundEntrants RoundEntrant[]
}

model Paper {
  id          String   @id @default(uuid())
  roundId     String   @unique
  fileUrl     String
  memoUrl     String
  uploadedAt  DateTime @default(now())
  memoAnswers Json?
  round       Round    @relation(fields: [roundId], references: [id])
}

model Submission {
  id             String   @id @default(uuid())
  roundId        String
  entrantId      String
  answers        Json
  idempotencyKey String   @unique
  submittedAt    DateTime @default(now())
  result         Result?
  entrant        Entrant  @relation(fields: [entrantId], references: [id])
  round          Round    @relation(fields: [roundId], references: [id])
}

model Result {
  id           String     @id @default(uuid())
  submissionId String     @unique
  score        Float
  releasedAt   DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model RoundEntrant {
  id           String   @id @default(uuid())
  round        Round    @relation(fields: [roundId], references: [id])
  roundId      String
  entrant      Entrant  @relation(fields: [entrantId], references: [id])
  entrantId    String
  registeredAt DateTime @default(now())

  @@unique([roundId, entrantId])
}
